{
  "name": "wenworks-ai-admin",
  "private": true,
  "type": "module",
  "description": "Wenworks AI 管理后台：Cloudflare Worker + D1，界面是 React + Mantine",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "worker": "wrangler dev",
    "seed": "node scripts/seed.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@tabler/icons-react": "^3.53.0",
    "marked": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "wrangler": "^4.142.0"
  }
}
